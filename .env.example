# On-prem management server (use one block OR the Smart-1 Cloud block below)
MANAGEMENT_HOST=192.168.1.1
MANAGEMENT_PORT=443
DOMAIN=SMC User
USERNAME=admin
PASSWORD=secret
# API_KEY=your-api-key   # preferred over username/password

# Smart-1 Cloud (comment out on-prem block if using this)
# S1C_URL=https://xxxx.maas.checkpoint.com
# API_KEY=your-cloud-api-key

# Optional — raises the NVD API rate limit from 5 to 50 requests/30s.
# Request one free at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Keywords used to filter the CISA KEV feed (free-text match on vendor/product name)
# and to pick out the Check Point CPE entries within an NVD CVE's version ranges.
ADVISORY_KEYWORDS=check point,checkpoint,gaia

# CPE vendor identifier(s) used for the structured NVD query (precise — matches the
# vendor field in NVD's CPE dictionary, not free text). Leave as-is unless Check Point
# ever gets cataloged under a different vendor slug.
NVD_CPE_VENDORS=checkpoint

# Gmail account the remediation drafts get saved into (via IMAP, [Gmail]/Drafts).
# Use an App Password (https://myaccount.google.com/apppasswords), not your real password.
# Nothing is ever sent — drafts sit for you to review and send yourself.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# server.py (the SmartConsole dashboard extension's local API host).
# Personal use on your own machine: leave all of these commented out.
# Sharing the dashboard with your team: uncomment and set SERVER_PUBLIC_HOST to this
# machine's real reachable hostname/IP. There is NO authentication — anyone who can
# reach this host/port sees your gateway inventory and CVE data, so only do this on a
# network you trust (firewall/VPN-restricted), never expose it to the public internet.
# SERVER_BIND_HOST=0.0.0.0
# SERVER_PUBLIC_HOST=advisorywatch.internal.example.com
# SERVER_PORT=5443

# Optional — use a real cert (e.g. from an internal CA) instead of the self-signed one,
# so colleagues installing the extension don't hit a cert-trust warning.
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_KEY_FILE=/path/to/key.pem

# Check Point's own structured Security Advisories feed (exact per-version Jumbo
# Hotfix Take cutoffs) is fetched automatically on every `check` run — no opt-in
# needed, it's just a public JSON GET. Product lines from that feed considered
# relevant to your gateway/management inventory (comma-separated); leave unset to
# use the built-in default (Security Gateways, Security Management, ClusterXL, VSX,
# CloudGuard Network, and common blades — see cpadvisories.DEFAULT_RELEVANT_PRODUCTS).
# CP_ADVISORY_PRODUCTS=Security Gateways,Security Management,ClusterXL

# Off by default. When enabled, `check` runs a bounded, read-only diagnostic (via the
# Management API's run-script -> cpinfo) on your real gateways/management server to
# see whether the Jumbo Hotfix Take that Check Point's advisory feed says fixes a CVE
# is actually installed. This is the ONLY thing in this tool that executes a command
# on your production infrastructure rather than just reading metadata. Without it,
# a known Take requirement still shows up as "needs review" with the required Take
# number — you just don't get the automatic yes/no against what's installed. Read
# the "Patch-level matching" section in README.md before turning this on.
# ENABLE_HOTFIX_CHECK=true
